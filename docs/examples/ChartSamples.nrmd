```cell_config
title: Line - requests over time
chart: line
height: 14
attributes: lines, points
widget-id: 435FBB18-3B85-4A78-A58C-A11E94D68762
```
```lua
local rows = {}
local east = { 24, 32, 28, 40, 36, 44 }
local west = { 18, 22, 30, 26, 34, 32 }
for i = 1, #east do
  local start = 1735689600 + (i - 1) * 3600
  rows[#rows + 1] = {
    beginTimeSeconds = start, endTimeSeconds = start + 3600,
    facet = "East", Requests = east[i]
  }
  rows[#rows + 1] = {
    beginTimeSeconds = start, endTimeSeconds = start + 3600,
    facet = "West", Requests = west[i]
  }
end
return { facets = { "Region" }, rows = rows }
```

